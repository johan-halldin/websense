# PostgreSQL/TimescaleDB connection used by apps/server, apps/ingest, and db/migrate.js
DATABASE_URL=postgres://postgres:postgres@localhost:5433/websense

# apps/server
PORT=3002

# apps/ingest
# Pick a public RIPE Atlas ping measurement and a handful of probe IDs from
# https://atlas.ripe.net/measurements/ - there is no default that works for
# everyone, so these must be set before running the ingest script.
RIPE_MEASUREMENT_ID=
RIPE_PROBE_IDS=
