{
    "name": "websense",
    "private": true,
    "version": "1.0.0",
    "packageManager": "pnpm@10.16.1",
    "scripts": {
        "format-check": "pnpm -r run format-check",
        "format-write": "pnpm -r run format-write",
        "lint-check": "pnpm -r run lint-check",
        "lint-apply": "pnpm -r run lint-apply",
        "check": "pnpm format-check && pnpm lint-check",
        "fix": "pnpm format-write && pnpm lint-apply",
        "test": "pnpm -r run test"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.2.0",
        "vitest": "^3.2.4"
    }
}
